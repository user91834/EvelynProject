# Backend Evelyn - variáveis de ambiente
# Copie para .env e preencha os valores. Não versionar .env.

# Diretório de dados (estado JSON e mídia)
DATA_DIR=./data

# URL pública do backend (para links de mídia e FCM)
PUBLIC_BASE_URL=
# No Render.com pode usar também:
# RENDER_EXTERNAL_URL=

# OpenAI (obrigatório para STT/LLM/TTS)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Auth: JWT (em produção use um segredo forte)
JWT_SECRET=
# Em desenvolvimento pode desabilitar auth (não usar em produção)
AUTH_DISABLED=0

# TTS alternativo (Inworld)
TTS_PROVIDER=openai
# INWORLD_API_KEY=
# INWORLD_TTS_VOICE_ID=Dennis
# INWORLD_TTS_MODEL_ID=inworld-tts-1.5-max

# Banco (opcional)
# DATABASE_URL=postgresql://...

# FCM (push)
# FCM_PROJECT_ID=seu-projeto
# GOOGLE_APPLICATION_CREDENTIALS=service-account.json
# Ou JSON inline: GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
